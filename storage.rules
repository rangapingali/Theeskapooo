rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function student(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@kitsw[.]ac[.]in$');
    }
    match /student-uploads/{uid}/{orderId}/{fileName} {
      // Uploads cannot overwrite files already referenced by an order.
      allow create: if student(uid)
        && orderId.matches('^[a-f0-9-]{36}$')
        && fileName.matches('^[a-f0-9-]{36}[.](pdf|doc|docx|ppt|pptx|xls|xlsx|odt|ods|odp|rtf|txt|csv|jpg|jpeg|png|webp|heic|tif|tiff)$')
        && request.resource.size > 0 && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
      allow read: if student(uid);
      // Cleanup and staff access use the server. Submitted files are immutable.
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
